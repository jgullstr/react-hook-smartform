{
  "name": "react-hook-smartform",
  "version": "8.0.0",
  "private": true,
  "description": "A thin layer over react-hook-form: scoped field names, self-registering fields and field arrays that read like markup",
  "license": "MIT",
  "author": "jgullstr",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:package"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-hook-form": "^7.77.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.77.0",
    "react-hook-form-floor": "npm:react-hook-form@7.77.0",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
